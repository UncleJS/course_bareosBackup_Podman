# bareos-webui.container — Bareos WebUI (Chapter 6)

[Unit]
Description=Bareos WebUI
Documentation=https://docs.bareos.org/IntroductionAndTutorial/BareosWebui.html
After=network-online.target bareos-director.service
Requires=bareos-director.service

[Container]
Image=docker.io/bareos/bareos-webui:24
ContainerName=bareos-webui
Volume=bareos-webui-config.volume:/etc/bareos-webui
# Host port from the course range 10110-10119; Apache listens on 80 inside
PublishPort=127.0.0.1:10110:80
Network=bareos.network
Label=app=bareos
Label=component=webui

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
