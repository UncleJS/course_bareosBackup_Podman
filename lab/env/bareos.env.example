# Copy to /home/bareos/.config/bareos/bareos.env and replace CHANGEME_* with:
#   openssl rand -base64 32
# Mode 600, owner bareos:bareos. Never commit real secrets.
# Literal passwords must also be pasted into bareos-dir.d / bareos-sd.d / FD conf
# (EnvironmentFile= does not substitute into .conf files).
BAREOS_SD_PASSWORD=CHANGEME_SD_PASSWORD
BAREOS_FD_PASSWORD=CHANGEME_FD_PASSWORD
BAREOS_DIRECTOR_PASSWORD=CHANGEME_DIRECTOR_PASSWORD
BAREOS_DB_HOST=bareos-db
BAREOS_DB_NAME=bareos
BAREOS_DB_USER=bareos
