# bareos-lab-director.container — Director
# Installed by scripts/install.sh, which fills in the @..._PORT@ values from
# scripts/common.sh (and renames everything for a JOB instance).

[Unit]
Description=Bareos lab Director
Requires=bareos-lab-db.service
After=bareos-lab-db.service

[Container]
Image=localhost/bareos-lab:latest
ContainerName=bareos-lab-director
Pod=bareos-lab.pod
Exec=director
Volume=bareos-lab-config.volume:/etc/bareos
Volume=bareos-lab-working.volume:/var/lib/bareos
Secret=bareos-lab-db-password,type=mount,target=db-password
Secret=bareos-lab-admin-password,type=mount,target=admin-password
Label=app=bareos-lab

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
