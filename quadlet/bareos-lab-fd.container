# bareos-lab-fd.container — File Daemon
# Installed by scripts/install.sh, which fills in the @..._PORT@ values from
# scripts/common.sh (and renames everything for a JOB instance).

[Unit]
Description=Bareos lab File Daemon
Requires=bareos-lab-director.service
After=bareos-lab-director.service

[Container]
Image=localhost/bareos-lab:latest
ContainerName=bareos-lab-fd
Pod=bareos-lab.pod
Exec=filedaemon
Volume=bareos-lab-config.volume:/etc/bareos
Volume=bareos-lab-working.volume:/var/lib/bareos
Label=app=bareos-lab

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=default.target
